# Copy this file to .env and set your master password, e.g.:
#   cp .env.example .env
#
# .env is gitignored. A real exported environment variable (if any)
# always wins over .env.
#
# While UPLOAD_MASTER_PASSWORD is unset or empty, the whole site
# returns 500 instead of running unprotected.
UPLOAD_MASTER_PASSWORD=change-me

# Optional: defaults to app/static/uploads. Relative paths use the project root.
# UPLOAD_DIRECTORY=/var/lib/upload/files
