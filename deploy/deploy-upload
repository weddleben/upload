#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/bin
export GIT_TERMINAL_PROMPT=0

# Installed root-owned, outside the checkout. The SSH key cannot replace it.
if [[ ! ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
    echo 'Only deployment of an explicit GitHub revision is allowed.' >&2
    exit 1
fi
expected_revision=${BASH_REMATCH[1]}
exec 9>/var/lib/upload-deploy/deploy.lock
flock -w 600 9
cd /var/www/upload
test -z "$(git status --porcelain)" || {
    echo 'Checkout has local changes; refusing to overwrite them.' >&2
    exit 1
}
git fetch origin main
# An older queued workflow must never deploy a newer, untested commit.
if [[ $(git rev-parse origin/main) != "$expected_revision" ]]; then
    echo 'Superseded by a newer main revision; skipping deployment.'
    exit 0
fi
git pull --ff-only origin main
test "$(git rev-parse HEAD)" = "$expected_revision"
venv/bin/python -m pip install -r requirements.txt
venv/bin/python -m pytest -q
sudo -n /usr/bin/systemctl reload upload.service
for attempt in {1..15}; do
    if curl --fail --silent --max-time 5 http://127.0.0.1:5001/ > /dev/null; then
        echo "Deployed $expected_revision successfully."
        exit 0
    fi
    sleep 2
done
echo 'Deployment health check failed; inspect upload.service.' >&2
exit 1
